# Copy to .env for local configuration. Never commit production secrets.
DB_PASSWORD=your_local_db_password
STUDY_SECRET_KEY=replace-with-a-random-secret-before-deployment
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_MAX_OUTPUT_TOKENS=450
AI_TEMPERATURE=0.3
AI_PROVIDER_TIMEOUT_SECONDS=8
AI_TOTAL_TIMEOUT_SECONDS=18
AI_RETRY_DELAY_SECONDS=0.2
RAG_MIN_SCORE=0.12
RAG_MAX_CONTEXT_CHARS=8000
